{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mad-openspec.local/schemas/change-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "story", "title", "why", "references", "capabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "story": {"type": "object", "additionalProperties": false, "required": ["id", "source"], "properties": {"id": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"}, "source": {"$ref": "#/definitions/string"}}},
    "title": {"$ref": "#/definitions/string"},
    "why": {"$ref": "#/definitions/string"},
    "references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"$ref": "#/definitions/string"}, "requirementId": {"$ref": "#/definitions/string"}}}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "requirements"], "properties": {"path": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"}, "purpose": {"$ref": "#/definitions/string"}, "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/requirement"}}}}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/string"}}
  },
  "definitions": {
    "string": {"type": "string", "minLength": 1},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["name", "when", "then"], "properties": {"name": {"$ref": "#/definitions/string"}, "given": {"$ref": "#/definitions/string"}, "when": {"$ref": "#/definitions/string"}, "then": {"$ref": "#/definitions/string"}, "and": {"type": "array", "items": {"$ref": "#/definitions/string"}}}},
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["operation", "name"],
      "properties": {"operation": {"enum": ["ADDED", "MODIFIED", "REMOVED", "RENAMED"]}, "name": {"$ref": "#/definitions/string"}, "text": {"$ref": "#/definitions/string"}, "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/scenario"}}, "from": {"$ref": "#/definitions/string"}, "reason": {"$ref": "#/definitions/string"}, "migration": {"$ref": "#/definitions/string"}},
      "allOf": [
        {"if": {"properties": {"operation": {"enum": ["ADDED", "MODIFIED"]}}}, "then": {"required": ["text", "scenarios"], "properties": {"text": {"type": "string", "pattern": "\\b(SHALL|MUST)\\b"}, "from": false, "reason": false, "migration": false}}},
        {"if": {"properties": {"operation": {"const": "REMOVED"}}}, "then": {"required": ["reason", "migration"], "properties": {"from": false, "text": false, "scenarios": false}}},
        {"if": {"properties": {"operation": {"const": "RENAMED"}}}, "then": {"required": ["from"], "properties": {"text": false, "scenarios": false, "reason": false, "migration": false}}}
      ]
    }
  }
}
