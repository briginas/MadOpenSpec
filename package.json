{
  "name": "mad-openspec",
  "version": "0.3.7",
  "description": "Prepare and close BMAD stories through OpenSpec",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briginas/MadOpenSpec.git"
  },
  "homepage": "https://github.com/briginas/MadOpenSpec#readme",
  "bugs": "https://github.com/briginas/MadOpenSpec/issues",
  "license": "MIT",
  "bin": {
    "mad-openspec": "dist/bin/mad-openspec.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist/",
    "schemas/",
    "skills/",
    "docs/usage.md",
    "docs/examples/story-dependencies/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "test": "node scripts/test.ts",
    "test:smoke": "node --test test/smoke.test.ts"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.16.0",
    "ajv": "8.20.0",
    "bmad-method": "6.12.4",
    "smol-toml": "1.9.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
